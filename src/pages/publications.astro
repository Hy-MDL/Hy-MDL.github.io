---
import Base from '../layouts/Base.astro';
import { PUBS, gapLabel, daysWaiting } from '../data/publications';
---
<Base title="Publications — Hyeonmin Jeon" active="pubs">

  <div class="wrap pubs-root">
    <div class="list-head">
      <div><h1>Publications</h1><p>Papers, posters, and drafts — with where each one went and what happened to it. Every entry keeps its full submission history.</p></div>
      <div class="filters"><button data-g="stage" data-v="all" aria-pressed="true">All</button><button data-g="stage" data-v="submitted">Submitted</button><button data-g="stage" data-v="review">Under review</button><button data-g="stage" data-v="rrc">RRC</button><button data-g="stage" data-v="pending">Pending</button><button data-g="stage" data-v="inprogress">In progress</button><button data-g="stage" data-v="published">Published</button><span style="width:10px"></span><button data-g="role" data-v="any" aria-pressed="true">Any author</button><button data-g="role" data-v="first">1st author</button><button data-g="role" data-v="co">Co-author</button></div>
    </div>
    <div class="legend">† equal contribution · * corresponding author · bold = me<br>stages: Submitted → With editor → Under review → RRC (required reviews completed, awaiting decision) → Decision · Pending = declined, next venue pending</div>

    {PUBS.map((p) => (
      <div class="pubrow" data-stage={p.filterStage} data-role={p.filterRole}><div class="y">{p.year}</div><div>
        <div class="top"><div><div class="t">{p.title}</div>
          <div class="a"><span set:html={p.authorsHtml}></span><span class={`role-chip ${p.roleClass ?? ''}`}>{p.role}</span></div>
          <div class="venue" set:html={p.venueHtml}></div></div>
          <span class={`status ${p.stageClass}`}>{p.stage}</span></div>
        <ul class="vtl">{p.events.map((e, i) => (
          <li class={`${e.bad ? 'bad' : ''} ${i === p.events.length - 1 ? 'cur' : ''}`}>
            <span class="d">{e.date.replace(/-/g, '.')}</span>
            <span class={`s ${e.bad ? 'bad' : ''} ${i === p.events.length - 1 ? 'cur' : ''}`}>{e.stage}</span>
            <span class="k"><span set:html={e.note ?? ''}></span>{i > 0 && <span class="el">{gapLabel(p.events[i - 1].date, e.date)} later</span>}</span>
          </li>
        ))}</ul>
        <div class="lk"><span class="lkoff">{p.lk}</span>
          {p.page && <a href={p.page}>idea, model &amp; results</a>}
          <span class="el">{daysWaiting(p)}d at this stage</span></div>
      </div></div>
    ))}

    <div class="hsec" style="margin-top:44px"><h2>In progress <span class="hnote">work being written or tested now — not yet submitted anywhere</span></h2></div>
    <div class="pubrow wip" data-stage="inprogress" data-role="first"><div class="y">now</div><div>
      <div class="top"><div><div class="t"><a href="/research/model-uncertainty-priors/">Learned Surrogate Priors for Bayesian Model Selection: Density, Uncertainty, and the Cost of a Sampler</a> <span class="role-chip">working title</span></div><div class="a"><b>Hyeon Min Jeon</b> <span class="role-chip">co-authors to be confirmed</span></div><div class="venue">A normalizing flow as a tractable surrogate for an intractable prior in Bayesian factor selection; uncertainty quantification over the model space · target venue to be decided</div></div><span class="status s-wip">Experimenting</span></div>
      <ol class="stages"><li class="done">Idea</li><li class="cur">Experiments</li><li>Drafting</li><li>Internal review</li><li>Submission</li></ol>
      <div class="note">The reference setting is Huang &amp; Shi (<i>Journal of Econometrics</i>, 2025): a mixture of <i>g</i>-priors over a factor-zoo model space, model uncertainty read off as the entropy of the posterior model probabilities. The paper treats the learned prior as a <b>surrogate that carries model uncertainty in its architecture</b> and asks three things of it. <b>Checked:</b> a normalizing flow (RealNVP with a sinh–arcsinh tail layer) reproduces the exact posterior over models to total variation 0.016, while a sampler-only GAN reaches the marginal likelihood only through importance weights whose effective sample size collapses (0.597). <b>Controlled:</b> because the flow has a density, Bayesian optimisation can tune its shape about 40 times more cheaply than a sampler allows; on held-out panels the tuned prior moves pricing error only from 0.25135 to 0.25045 while posterior entropy falls from 0.783 to 0.321, so the decision barely depends on the prior and the uncertainty measure does. <b>Adapted:</b> re-tuning the prior at every refit does not beat the flow as trained (stationary −0.00235 [−0.00822, +0.00372]; Fama–French +0.02025 [−0.00018, +0.04385]) and again mainly lowers entropy. Next: control the prior against a calibration target rather than pricing error. Presented as a lab seminar on 2026.01.08; nothing submitted yet.</div>
      <div class="lk"><a class="go" href="/research/model-uncertainty-priors/">experiments &amp; write-up →</a></div>
    </div></div>
    <div class="pubrow wip" data-stage="inprogress" data-role="first"><div class="y">now</div><div>
      <div class="top"><div><div class="t"><a href="/projects/exchange-queueing/">Bayesian Capacity Sizing for an Exchange Matching Queue under Over-Dispersed Arrivals</a> <span class="role-chip">working title</span></div><div class="a"><b>Hyeon Min Jeon</b> <span class="role-chip">co-authors to be confirmed</span></div><div class="venue">Queueing analysis of BTC/USDT exchange traffic with a Bayesian treatment of the arrival process · target venue to be decided</div></div><span class="status s-wip">Experimenting</span></div>
      <ol class="stages"><li class="done">Idea</li><li class="cur">Experiments</li><li>Drafting</li><li>Internal review</li><li>Submission</li></ol>
      <div class="note">Starts from a 2025 team course project on exchange traffic, re-run in 2026.09–10 on 1.30 GB of the original tick data. Established: order arrivals are over-dispersed under every regime conditioning tried, and a trace-driven G/G/c needs about 48 servers to hold a 100 ms queueing SLA on a day where Erlang-C says one. The Bayesian part makes the arrival process a learned object and sizes capacity by a 95 % chance constraint on the simulated queue, scored block by block against the smallest server count that held on the real trace. A single-scale Cox posterior is honest only with a heavy-tailed burst law, at about four times the oracle's servers. Grouping same-millisecond trades shows where the uncertainty actually lives, in the <b>batch sizes</b>: a model that carries the batch law, with nested sub-second clustering, holds the SLA on 84 % of the in-sample minutes at 1.26 times the oracle's servers, and a learned surrogate of the SLA probability makes that control cheap enough to re-solve every minute (0.03 s per decision). Its promises are still too confident on the busiest day (72 % held against 98 % promised), which sets the next model. Plain queueing, Bayesian inputs, a surrogate to act on them.</div>
      <div class="lk"><a class="go" href="/projects/exchange-queueing/">experiments &amp; write-up →</a></div>
    </div></div>

    <div class="hsec" style="margin-top:44px"><h2>Conference</h2></div>
    <div class="pubrow" data-stage="presented" data-role="co"><div class="y">2025</div><div>
      <div class="top"><div><div class="t">A Study for Forecasting Solar Energy Power Generation</div><div class="a">YoungDoo Jeong<sup>*</sup>, HaeRim Kim, Dae Hyuk You, <b>Hyeon Min Jeon</b>, Arnie de Castro, TaeYoon Lee <span class="role-chip">co-author · talk</span></div><div class="venue"><b>ISF 2025</b> — 45th International Symposium on Forecasting, Beijing · presented 2025.07.01 · joint work with <b>SAS Institute</b> (Cary, NC) and the University of Seoul</div></div><span class="status s-acc">Presented</span></div>
      <div class="lk">Hourly solar generation in Seoul (KEPCO market series + KMA ASOS weather) with a hybrid CNN–LSTM–Transformer: one-day-ahead RMSE 0.304 against 0.392 (CNN–LSTM), 3.19 (TimesFM) and 4.2 (ARIMA) over 100 simulations; with only two weeks of history, diffusion-generated synthetic series stacked on the real data cut RMSE from 2.91 to 1.97. <a class="go" href="/talks/isf2025-solar-forecasting.pdf">slides (PDF)</a></div>
      <ul class="vtl"><li><span class="d">2025.07.01</span><span class="s ok">Presented</span><span class="k">ISF 2025, Beijing — talk delivered</span></li></ul>
    </div></div>
    <div class="pubrow" data-stage="presented" data-role="first"><div class="y">2023</div><div>
      <div class="top"><div><div class="t">Dealing with the Imbalanced-Data Problem with a Diffusion Model</div><div class="a"><b>Hyeon Min Jeon</b>, Minhyeok Lee <span class="role-chip first">1st author</span></div><div class="venue"><b>KICS</b> — Korea Institute of Communication Sciences, fall conference 2023 · Chung-Ang University</div></div><span class="status s-acc">Presented</span></div>
      <div class="lk">Diffusion-model oversampling for a credit-card fraud dataset, compared with random over/under-sampling and SMOTE on precision, recall and accuracy.</div>
    </div></div>
    <div class="pubrow" data-stage="presented" data-role="first"><div class="y">2024</div><div>
      <div class="top"><div><div class="t">Personalized Sleep Score Prediction Model Using a Lifelog Dataset</div><div class="a"><b>Hyeon Min Jeon</b> et al. <span class="role-chip first">1st author</span></div><div class="venue"><b>ETRI</b> Human Understanding AI Paper Challenge (competition, not a journal) · 2024 · Chung-Ang University</div></div><span class="status s-rev">Submitted</span></div>
      <div class="lk">Smartwatch lifelog data (Withings / Empatica) → nightly sleep-score prediction; the model, not the data, was adjusted this time.</div>
    </div></div>
    <div class="noresult" hidden>Nothing at this stage yet.</div>
  </div>

<script is:inline>
(function () {
  var root = document.querySelector('.pubs-root');
  if (!root) return;
  var btns = Array.prototype.slice.call(root.querySelectorAll('.filters button'));
  var rows = Array.prototype.slice.call(root.querySelectorAll('.pubrow'));
  var heads = Array.prototype.slice.call(root.querySelectorAll('.hsec'));
  var empty = root.querySelector('.noresult');
  var stage = 'all', role = 'any';

  function apply() {
    var shown = 0;
    rows.forEach(function (r) {
      var ok = (stage === 'all' || r.dataset.stage === stage) &&
               (role === 'any' || r.dataset.role === role);
      r.hidden = !ok;
      if (ok) shown++;
    });
    heads.forEach(function (h) {
      var el = h.nextElementSibling, any = false;
      while (el && !el.classList.contains('hsec')) {
        if (el.classList.contains('pubrow') && !el.hidden) { any = true; break; }
        el = el.nextElementSibling;
      }
      h.hidden = !any;
    });
    if (empty) empty.hidden = shown > 0;
    btns.forEach(function (b) {                       // grey out a chip that can match nothing
      var k = b.dataset.v, g = b.dataset.g, hits = rows.filter(function (r) {
        return (g === 'stage' ? (k === 'all' || r.dataset.stage === k) : (k === 'any' || r.dataset.role === k)) &&
               (g === 'stage' ? (role === 'any' || r.dataset.role === role) : (stage === 'all' || r.dataset.stage === stage));
      }).length;
      b.classList.toggle('none', hits === 0);
      b.title = hits + (hits === 1 ? ' paper' : ' papers');
    });
    btns.forEach(function (b) {
      var on = b.dataset.g === 'stage' ? stage === b.dataset.v : role === b.dataset.v;
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
  }

  btns.forEach(function (b) {
    b.addEventListener('click', function () {
      if (b.dataset.g === 'stage') { stage = b.dataset.v; if (b.dataset.v === 'all') role = 'any'; }
      else role = b.dataset.v;
      apply();
    });
  });
  apply();
})();
</script>

</Base>
