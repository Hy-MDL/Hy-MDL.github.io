---
import Base from '../layouts/Base.astro';
import { PUBS } from '../data/publications';
const first = PUBS.filter((p) => p.filterRole === 'first'), co = PUBS.filter((p) => p.filterRole === 'co');
const last = (p: (typeof PUBS)[number]) => p.events[p.events.length - 1];
const fmt = (iso: string) => iso.slice(0, 7).replace('-', '.');
const authorsShort = (html: string) =>
  html.replace(/<sup>\*<\/sup>/g, '*')
    .replace(/([A-Z][a-z]+) ([A-Z][a-z]+) ([A-Z][a-z]+)(\*?)/g, (_m, a, b, c, star) => `${a[0]}. ${b[0]}. ${c}${star}`)
    .replace(/([A-Z][a-z]+) ([A-Z][a-z]+)(\*?)(?=,|<|$)/g, (_m, a, b, star) => `${a[0]}. ${b}${star}`);
const venue = (p: (typeof PUBS)[number]) => p.venueHtml.replace(/ · earlier title:.*$/, '').replace(/^(Submitted to|Last submitted to) /, '');
---
